// Datamoshing compute shader

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

// Default border size for group.
#define DEFAULT_GROUP_BORDER_SIZE 8
#define GROUP_BORDER_SIZE (DEFAULT_GROUP_BORDER_SIZE)

// Shader parameters

// SceneColor texture
Texture2D OriginalSceneColor;
Texture2D Velocity;
Texture2D Depth;

// Viewport size
uint4 ViewportRect;

// This is the UV for Viewport
float2 ViewportInvSize;

// This is the multiplier to scale Viewport UV (0..1) to current SceneColor RT
float2 SceneColorUVScale;

// TODO: Document these
float4x4 prev_screen_to_world;
float4x4 curr_screen_to_world;
float4x4 world_to_screen;

// Output
RWTexture2D<float4> Output;
RWTexture2D<float4> historyBuffer;

// Compute Shader code
[numthreads(GROUP_BORDER_SIZE, GROUP_BORDER_SIZE, 1)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID) {
	// Check that we are in scope
	if (any(DispatchThreadId >= ViewportRect.zw)) {
		return;
	}

	// If we have the Original Scene Color still here, we need to use the original offset as well
	// Due to UniformBuffer referring to the Viewport before TAA (this might change in the future?) we need to apply scale to the UV
	float2 sampleUV = (float2(View.ViewRectMin.xy) + (DispatchThreadId + 0.5)) * ViewportInvSize;
	float2 outputUV = View.ViewRectMin.xy + DispatchThreadId;

	// At this point our sampleUV is mapped to 0..1
	// This is the UV value one might want to use if f.ex. altering the coordinates via shader formula

	// As the actual viewport might not utilize the full texture, we need to scale accordingly - see calculation on the .cpp side
	sampleUV = sampleUV * SceneColorUVScale;

	// Sample textures
	float4 OriginalColor = OriginalSceneColor.SampleLevel(GlobalPointClampedSampler, sampleUV, 0);
	float4 velocityColor = Velocity.SampleLevel(GlobalPointClampedSampler, sampleUV, 0);
	float depthColor = Depth.SampleLevel(GlobalPointClampedSampler, sampleUV, 0).r; // Only red channel matters

	bool has_motion = length(velocityColor.rg) > 0;

	// Calculate screen-space object movement
	// TODO: Historical depth buffer for more accuracy?
	float2 curr_pos = outputUV;
	float4 screen_point = float4(curr_pos, depthColor, 1.0f);
	float2 prev_pos = mul(world_to_screen, mul(prev_screen_to_world, screen_point));
	float2 screen_diff = curr_pos - prev_pos;

	// Try to nullify motion if the camera isn't moving
	float threshold = 3.0f;
	screen_diff.x *= screen_diff.x > threshold;
	screen_diff.y *= screen_diff.y > threshold;
		
	if (!has_motion) {
		// Only apply the less accurate guess when we don't have a real velocity vector
		velocityColor.rg = screen_diff * depthColor;
	}
	has_motion = length(velocityColor.rg) > 0;

	// Map velocity down to more reasonable vector values
	velocityColor = has_motion * (velocityColor - 0.5f);

	// Visualize motion vectors on top of the normal frame
	// OriginalColor.rg += 0.1 * velocityColor.rg;

	// Visualize motion vectors in output color
	// OriginalColor = float4(velocityColor.rg, 0, 0);

	// Write output
	float2 motionUV = outputUV + (1.0f * (velocityColor.rg));

	// Copy current frame to history, then distort. If the CPU set the history buffer as the scene color, this only
	// distorts.
	historyBuffer[outputUV] = OriginalColor;
	if (has_motion) {
		historyBuffer[motionUV] = float4(OriginalColor.rgb, 1.0f * has_motion);
	}

	// Copy history buffer to output framebuffer
	Output[outputUV] = historyBuffer[outputUV];
}